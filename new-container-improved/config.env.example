# ============================================================
# AGL local build configuration
# Copy to config.env and adjust. No secrets needed for local builds.
# ============================================================

# Target machine.
# Default: qemux86-64 (runs with runqemu, no real hardware needed)
# Other options: qemuarm64, raspberrypi4, raspberrypi5, h3ulcb-nogfx, m3ulcb-nogfx
MACHINE=qemux86-64

# AGL branch to build (master = latest development)
AGL_BRANCH=master

# Which AGL features to enable (aglsetup.sh -f arguments).
# agl-devel adds debug tools; remove it for a slimmer production image.
AGL_FEATURES=agl-demo agl-devel agl-netboot

# Image recipe(s) to build
AGL_IMAGE=agl-ivi-demo-flutter

# Number of parallel bitbake threads. Set to your CPU count.
#BB_NUMBER_THREADS=8
#PARALLEL_MAKE=-j8

# Set to "1" to also build the cross-SDK after the image
BUILD_SDK=1

# Optional: pin to a specific Gerrit change for testing a patch.
# Leave empty for a plain branch build.
#GERRIT_CHANGE_NUMBER=
#GERRIT_PATCHSET_NUMBER=
# Project the change belongs to (e.g. AGL/meta-agl)
#GERRIT_PROJECT=

# Optional: skip repo sync if the source tree already exists
# (useful when iterating on local changes). Set to "1" to skip.
SKIP_REPO_SYNC=0
