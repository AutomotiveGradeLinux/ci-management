# ============================================================
# AGL CI – required secrets / environment variables
# Copy to secrets.env, fill in values, never commit the file.
# Pass to docker run: --env-file secrets.env
# ============================================================

# ----- Gerrit change parameters (injected by GH Actions / CI system) -----
GERRIT_PROJECT=AGL/AGL-repo
GERRIT_BRANCH=master
GERRIT_REFSPEC=refs/heads/master
GERRIT_CHANGE_NUMBER=
GERRIT_PATCHSET_NUMBER=
# GERRIT_HOST defaults to gerrit.automotivelinux.org when empty
GERRIT_HOST=

# ----- Build target parameters -----
MACHINE=qemux86-64
# BUILDONLY: skip all machines except this one (or "ignore" to build all)
BUILDONLY=
# Release parameters (leave empty for CI/verify jobs)
RELEASE_BRANCH=
RELEASE_VERSION=
# Skip rsync upload even when RELEASE_BRANCH is set (set to "1" to skip)
UPLOAD=
# Build CI identifiers (set by CI system)
BUILD_ID=
BUILD_NUMBER=
BUILD_URL=
JOB_NAME=

# ----- SSH keys (paths inside the container) -----
# Mount your actual key files as read-only secrets:
#   docker run -v /path/to/gerrit_key:/run/secrets/ssh_gerrit:ro ...
# The lib/00-ssh.sh helper installs them into ~/.ssh automatically.
SSH_GERRIT_KEY_PATH=/run/secrets/ssh_gerrit       # was Jenkins cred d28b1f3b-…
SSH_DOWNLOAD_KEY_PATH=/run/secrets/ssh_download   # was Jenkins cred 2d097b8f-…
SSH_AGLDOCS_KEY_PATH=/run/secrets/ssh_agldocs      # was Jenkins cred jenkins-github-agldocs

# ----- Download / artifact server -----
ARTIFACT_HOST=jenkins-slave@10.30.72.8
ARTIFACT_BASE=/srv/download/AGL

# ----- LAVA lab credentials -----
LAB_AGL_USER=
LAB_AGL_TOKEN=
LAB_BAYLIBRE_USER=
LAB_BAYLIBRE_TOKEN=
LAB_BAYLIBRE_SEATTLE_USER=
LAB_BAYLIBRE_SEATTLE_TOKEN=
AGLLAVAUSER=
AGLLAVATOKEN=

# ----- KernelCI / email report tokens -----
KCI_EMAIL_AUTH_TOKEN=
BAY_KCIAPI_TOKEN=
AGL_KCIAPI_TOKEN=

# ----- Gerrit voting (optional – leave empty to skip voting) -----
# When set, lib/90-gerrit-review.sh sends +1/-1 after LAVA results.
GERRIT_REVIEW_HOST=gerrit.automotivelinux.org
GERRIT_REVIEW_PORT=29418
GERRIT_REVIEW_USER=agl-jobbuilder
# SSH key path inside the container (usually same as SSH_GERRIT_KEY_PATH)
GERRIT_REVIEW_KEY=/run/secrets/ssh_gerrit

# ----- Packer cloud config (ci-management jobs only) -----
# Mount your cloud credentials file:
#   docker run -v /path/to/cloud.env:/run/secrets/cloudenv:ro ...
CLOUDENV=/run/secrets/cloudenv
